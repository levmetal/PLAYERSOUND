# Base URL for the search/catalog API. Leave empty to use the local /api/search route.
NEXT_PUBLIC_SEARCH_API_BASE=

# Base URL for the audio stream resolver API. Leave empty to use the local /api/soundplayer route.
# Point this at the external YT-AUDIO service (e.g. https://yt-audio-l01p.onrender.com) once it's back up.
NEXT_PUBLIC_AUDIO_API_BASE=
