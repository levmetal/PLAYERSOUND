# Base URL for the search/catalog API. Leave empty to use the local /api/search route.
NEXT_PUBLIC_SEARCH_API_BASE=

# Base URL for the audio stream resolver API. Leave empty to use the local /api/soundplayer route.
# Point this at the external YT-AUDIO service (e.g. https://yt-audio-l01p.onrender.com) once it's back up.
# Only used by the "native" playback engine — see NEXT_PUBLIC_PLAYBACK_MODE below.
NEXT_PUBLIC_AUDIO_API_BASE=

# Which playback engine components/player.jsx uses — see docs/AUDIO_BACKEND_BLOCKERS.md.
# - native (default, leave empty): real <audio> streaming via /api/soundplayer, no ads.
#   Only reaches YouTube reliably from a residential IP (e.g. `npm run dev` on your own
#   machine) — YouTube's bot detection blocks datacenter IPs like Vercel's or Render's.
#   Falls back to "iframe" automatically at runtime if it fails to load.
# - iframe: plays via YouTube's own IFrame Player API in the visitor's browser instead —
#   works from any host since the request never touches our server, but the YouTube
#   player becomes visible in the UI and ads *can* appear (not guaranteed — see the doc).
#   Set this on the hosted Vercel deployment.
NEXT_PUBLIC_PLAYBACK_MODE=
